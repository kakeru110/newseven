  "formulas": {
    "occupancyRate": "nightsActual / calendarDays",
    "adr": "revenue.total / nightsRevenue",
    "alos": "nightsActual / cleaningCount",
    "variableCostTotal": "cleaningTotalInclTax + otaFee + mgmtSupportFeeInclTax + utilities + supplies",
    "contributionMargin": "revenue.total - variableCostTotal",
    "contributionMarginRate": "contributionMargin / revenue.total",
    "fixedCostTotal": "sum(fixedCosts)",
    "operatingProfit": "contributionMargin - fixedCostTotal",
    "breakEvenRevenue": "fixedCostTotal / contributionMarginRate",
    "breakEvenOccupancy": "breakEvenRevenue / adr / calendarDays",
    "breakEvenPricePerNight": "(cleaning_total_per_stay_incl_tax / N + utilities_per_night + supplies_per_night) / (1 - otaRate - mgmt_support_rate_excl_tax * consumption_tax_multiplier)",
    "contributionPerNightByChannel": "adr * (1 - otaRate - mgmt_support_rate_excl_tax * consumption_tax_multiplier) - cleaning_total_per_stay_incl_tax / alos - utilities_per_night - supplies_per_night"
  },
